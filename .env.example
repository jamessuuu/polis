# polis environment
#
# Only api/lead.mjs reads any of this. The site itself is static and the import
# and export paths run entirely in the visitor's browser, so nothing here is
# needed to render polis or to use the library's free templates.
#
# Copy to .env for local work, or set these in the Vercel project settings for
# a deployment. Nothing in here belongs in git: `.gitignore` already excludes
# `*.local`, and `.env` should be added there before a real value is written.

# ---------------------------------------------------------------------------
# Email, for POST /api/lead
# ---------------------------------------------------------------------------
# No provider is chosen for you and none is hardcoded. The function needs an
# HTTPS endpoint that accepts a JSON POST with a bearer token, and it sends
# this body:
#
#   { "from": ..., "to": ..., "subject": ..., "text": ..., "reply_to": ... }
#
# That shape is defined in one place, `mailBody` in lib/lead.mjs. A provider
# that wants different field names needs an edit there and nowhere else.
#
# With ANY of the four below missing, the function answers 503 with
# {"ok": false, "reason": "not-configured"}. It does not queue the lead and it
# never reports a send that did not happen.

POLIS_LEAD_EMAIL_ENDPOINT=
POLIS_LEAD_EMAIL_TOKEN=
POLIS_LEAD_TO=
POLIS_LEAD_FROM=

# Optional. Prefixes the subject line. Defaults to "polis lead".
POLIS_LEAD_SUBJECT_PREFIX=

# ---------------------------------------------------------------------------
# Origin
# ---------------------------------------------------------------------------
# The origin the site is served from, used for the Origin check. On Vercel,
# VERCEL_URL is used when this is unset. When NEITHER is set, every request
# that carries an Origin header is refused: that is fail-closed on purpose, and
# it means a browser form will not work until this is set.

POLIS_SITE_URL=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Salt for the HMAC that turns a caller IP into a rate-limit key. Without it a
# random value is minted once per process: still a working limiter, still
# unlinkable, but the key changes whenever a function instance recycles. No raw
# address is ever stored either way.

POLIS_LEAD_IP_SALT=

# ---------------------------------------------------------------------------
# Kill switch
# ---------------------------------------------------------------------------
# Set to 1 to stop every send immediately, with no deploy. The function then
# answers 503 with {"ok": false, "reason": "frozen"}.

POLIS_LEAD_FREEZE=
